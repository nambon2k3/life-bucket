# Copy to backend/.env when you run the API on the host
# (docker compose injects its own service hostnames and does not need this file).

DATABASE_URL=postgresql+psycopg://habbit:habbit@localhost:5433/habbit
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://habbit:habbit@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Local model server. Ollama default. LM Studio also works if it speaks the Ollama API.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

CORS_ORIGINS=http://localhost:5173
